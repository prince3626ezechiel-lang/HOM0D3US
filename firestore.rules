rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isVerifiedAdminEmail() {
      return isVerified() && request.auth.token.email == 'keturaepices@gmail.com';
    }

    function isAdmin() {
      return isVerifiedAdminEmail() || (
        isVerified() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // --- Validation Blueprints ---
    function isValidMember(data) {
      return data.keys().hasAll(['uid', 'displayName', 'callsign', 'title', 'city', 'role', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'callsign', 'title', 'city', 'role', 'status', 'photoUrl', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.callsign is string && data.callsign.size() >= 2 && data.callsign.size() <= 40 && data.callsign.matches('^[A-Z0-9_\\- ]+$')
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 100
        && data.city is string && data.city.size() >= 1 && data.city.size() <= 80
        && data.role in ['sovereign', 'operator', 'observer']
        && data.status in ['actif', 'veille', 'archive']
        && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMemberPrivate(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'clearanceNote', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && (!('clearanceNote' in data) || (data.clearanceNote is string && data.clearanceNote.size() <= 240))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMasterAnchor(data) {
      return data.keys().hasAll(['uid', 'ownerName', 'codename', 'location', 'coordinates', 'directive', 'posture', 'focusModules', 'checkInCount', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'ownerName', 'codename', 'location', 'coordinates', 'directive', 'posture', 'focusModules', 'checkInCount', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.ownerName is string && data.ownerName.size() >= 1 && data.ownerName.size() <= 80
        && data.codename is string && data.codename.size() >= 2 && data.codename.size() <= 60
        && data.location is string && data.location.size() >= 2 && data.location.size() <= 100
        && data.coordinates is string && data.coordinates.size() >= 2 && data.coordinates.size() <= 60
        && data.directive is string && data.directive.size() >= 4 && data.directive.size() <= 600
        && data.posture in ['Souverain', 'Vigilance', 'Immersion', 'Veille']
        && data.focusModules is list && data.focusModules.size() <= 6
        && (data.focusModules.size() == 0 || (data.focusModules[0] is string && data.focusModules[0].size() <= 60))
        && data.checkInCount is number && data.checkInCount >= 0 && data.checkInCount <= 1000000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidVaultMemory(data) {
      return data.keys().hasAll(['uid', 'title', 'category', 'classification', 'content', 'tags', 'pinned', 'source', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'title', 'category', 'classification', 'content', 'tags', 'pinned', 'source', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 120
        && data.category in ['Protocole', 'Mémoire', 'Stratégie', 'Technique', 'Abidjan']
        && data.classification in ['Souverain', 'Confidentiel', 'Opérationnel']
        && data.content is string && data.content.size() >= 4 && data.content.size() <= 4000
        && data.tags is list && data.tags.size() <= 8
        && (data.tags.size() == 0 || (data.tags[0] is string && data.tags[0].size() <= 40))
        && data.pinned is bool
        && data.source is string && data.source.size() >= 1 && data.source.size() <= 80
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidActivityEntry(data) {
      return data.keys().hasAll(['uid', 'memberName', 'actionType', 'category', 'summary', 'location', 'createdAt'])
        && data.keys().hasOnly(['uid', 'memberName', 'actionType', 'category', 'summary', 'details', 'location', 'createdAt'])
        && isValidId(data.uid)
        && data.memberName is string && data.memberName.size() >= 1 && data.memberName.size() <= 80
        && data.actionType in ['ANCRAGE', 'MEMOIRE', 'AUTH', 'POSTURE', 'SYNC']
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 60
        && data.summary is string && data.summary.size() >= 2 && data.summary.size() <= 180
        && (!('details' in data) || (data.details is string && data.details.size() <= 600))
        && data.location is string && data.location.size() >= 1 && data.location.size() <= 80
        && data.createdAt is timestamp;
    }

    // --- Collection: admins ---
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list, write: if false;
    }

    // --- Collection: members ---
    match /members/{memberId} {
      allow get: if isValidId(memberId) && (isOwner(memberId) || isAdmin());
      allow list: if isSignedIn() && (isVerifiedAdminEmail() || resource.data.uid == request.auth.uid);

      allow create: if isVerified()
        && isValidId(memberId)
        && isValidMember(incoming())
        && incoming().uid == request.auth.uid
        && memberId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (incoming().role == 'operator' || isAdmin());

      allow update: if isVerified()
        && isValidId(memberId)
        && isValidMember(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            isOwner(memberId)
            && incoming().role == existing().role
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'callsign', 'title', 'city', 'status', 'photoUrl', 'updatedAt'])
          )
        );

      allow delete: if isValidId(memberId) && isAdmin();

      // Isolated PII subcollection
      match /private/{docId} {
        allow get: if isValidId(memberId) && isValidId(docId) && (isOwner(memberId) || isAdmin());
        allow list: if isSignedIn() && (isVerifiedAdminEmail() || (isOwner(memberId) && resource.data.uid == request.auth.uid));

        allow create: if isVerified()
          && isValidId(memberId)
          && isValidId(docId)
          && isValidMemberPrivate(incoming())
          && incoming().uid == request.auth.uid
          && memberId == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isVerified()
          && isValidId(memberId)
          && isValidId(docId)
          && isValidMemberPrivate(incoming())
          && isOwner(memberId)
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'clearanceNote', 'updatedAt']);

        allow delete: if isValidId(memberId) && isValidId(docId) && isAdmin();
      }
    }

    // --- Collection: anchors ---
    match /anchors/{anchorId} {
      allow get: if isValidId(anchorId) && (isOwner(anchorId) || isAdmin());
      allow list: if isSignedIn() && (isVerifiedAdminEmail() || resource.data.uid == request.auth.uid);

      allow create: if isVerified()
        && isValidId(anchorId)
        && isValidMasterAnchor(incoming())
        && incoming().uid == request.auth.uid
        && anchorId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerified()
        && isValidId(anchorId)
        && isValidMasterAnchor(incoming())
        && (isOwner(anchorId) || isAdmin())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action: Update directive or profile metadata
          incoming().diff(existing()).affectedKeys().hasOnly(['ownerName', 'codename', 'location', 'coordinates', 'directive', 'posture', 'focusModules', 'updatedAt']) ||
          // Action: Log an anchor check-in
          (incoming().checkInCount == existing().checkInCount + 1 && incoming().diff(existing()).affectedKeys().hasOnly(['checkInCount', 'updatedAt'])) ||
          // Action: Full update by admin
          isAdmin()
        );

      allow delete: if isValidId(anchorId) && isAdmin();
    }

    // --- Collection: vault_memories ---
    match /vault_memories/{memoryId} {
      allow get: if isValidId(memoryId) && isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (isVerifiedAdminEmail() || resource.data.uid == request.auth.uid);

      allow create: if isVerified()
        && isValidId(memoryId)
        && isValidVaultMemory(incoming())
        && incoming().uid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerified()
        && isValidId(memoryId)
        && isValidVaultMemory(incoming())
        && (existing().uid == request.auth.uid || isAdmin())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action: Toggle pin
          incoming().diff(existing()).affectedKeys().hasOnly(['pinned', 'updatedAt']) ||
          // Action: Edit content
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'category', 'classification', 'content', 'tags', 'pinned', 'source', 'updatedAt'])
        );

      allow delete: if isValidId(memoryId) && isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
    }

    // --- Collection: activity_history ---
    match /activity_history/{activityId} {
      allow get: if isValidId(activityId) && isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (isVerifiedAdminEmail() || resource.data.uid == request.auth.uid);

      allow create: if isVerified()
        && isValidId(activityId)
        && isValidActivityEntry(incoming())
        && incoming().uid == request.auth.uid
        && incoming().createdAt == request.time;

      allow update: if false; // Audit trail is immutable
      allow delete: if isValidId(activityId) && isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
    }
  }
}
